{
    "key": "c",
    "name": "+Compile/Comments",
    "icon": "gear",
    "type": "bindings",
    "bindings": [
        {
            "key": "c",
            "name": "Compile project",
            "icon": "gear",
            "type": "command",
            "command": "workbench.action.tasks.build"
        },
        {
            "key": "l",
            "name": "Toggle line comment",
            "icon": "comment",
            "type": "command",
            "command": "editor.action.commentLine"
        },
        {
            "key": "n",
            "name": "Next error",
            "icon": "arrow-down",
            "type": "command",
            "command": "editor.action.marker.nextInFiles"
        },
        {
            "keys": "c.y",
            "name": "Copy and comment lines",
            "type": "command",
            "command": "runCommands",
            "args": {
                "commands":[
                    "editor.action.copyLinesUpAction",
                    "editor.action.commentLine",
                    "cursorDown"
                ]
            }
        },
        {
            "key": "N",
            "name": "Previous error",
            "icon": "arrow-up",
            "type": "command",
            "command": "editor.action.marker.prevInFiles"
        }
    ]
}
